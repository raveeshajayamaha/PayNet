PORT=5000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
# Generate a private secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
# Explicit development/test only; lifetime cap LKR 10,000 per wallet. Always disabled in production.
DEMO_FUNDING_ENABLED=false
# Local single-member replica set. Atlas: use its mongodb+srv:// URI with /paynet.
# Never commit a real URI/password. With no URI, development runs the UI/network demo only.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.girqzre.mongodb.net/
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
# Exact Socket.IO origins, comma-separated. No wildcard, path, or trailing slash.
SOCKET_ALLOWED_ORIGINS=http://localhost:5173
